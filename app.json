{
  "expo": {
    "name": "Leap_MVP",
    "slug": "Leap_MVP",
    "scheme": "leapmvp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brandmark.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/brandmark.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leapmvp.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Leap needs camera access to record your daily challenge.",
        "NSMicrophoneUsageDescription": "Leap needs microphone access to record audio with your video.",
        "NSPhotoLibraryUsageDescription": "Leap needs photo library access so you can attach a video to your challenge.",
        "NSPhotoLibraryAddUsageDescription": "Leap can save your completed takes to your photo library when you enable Save to camera roll.",
        "NSUserNotificationsUsageDescription": "Leap uses notifications to remind you when todayâ€™s challenge is live and before time runs out.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.leapmvp.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brandmark.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brandmark.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-web-browser",
      "expo-media-library",
      "expo-video",
      "expo-dual-camera"
    ],
    "extra": {
      "eas": {
        "projectId": "a9f05aed-d919-4d1f-a611-7686ff777fe8"
      },
      "firebase": {
        "apiKey": "AIzaSyCw4_L2aawbQKIhTQ5jBppwDBeK76U5Yxk",
        "authDomain": "leap-e4cce.firebaseapp.com",
        "projectId": "leap-e4cce",
        "storageBucket": "leap-e4cce.firebasestorage.app",
        "messagingSenderId": "1047286135542",
        "appId": "1:1047286135542:web:d5a184e16b3f9ee8b20ad7"
      },
      "requireLoginEmailOtp": false,
      "requirePostModeration": false
    }
  }
}
