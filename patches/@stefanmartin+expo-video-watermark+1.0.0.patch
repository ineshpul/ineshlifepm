+  private fun resolveVideoRenderSize(videoPath: String, promise: Promise) {
+    val cleanVideoPath = videoPath.removePrefix("file://")
+    val videoFile = File(cleanVideoPath)
+    if (!videoFile.exists()) {
+      promise.reject("VIDEO_NOT_FOUND", "Video file not found at path: $cleanVideoPath", null)
+      return
+    }
+
+    val retriever = MediaMetadataRetriever()
+    try {
+      retriever.setDataSource(cleanVideoPath)
+      val rawVideoWidth = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH)?.toIntOrNull() ?: 0
+      val rawVideoHeight = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT)?.toIntOrNull() ?: 0
+      val rotation = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_ROTATION)?.toIntOrNull() ?: 0
+      val (width, height) = if (rotation == 90 || rotation == 270) {
+        rawVideoHeight to rawVideoWidth
+      } else {
+        rawVideoWidth to rawVideoHeight
+      }
+
+      if (width <= 0 || height <= 0) {
+        promise.reject("VIDEO_DIMENSIONS_ERROR", "Failed to get video dimensions (width=$width, height=$height)", null)
+        return
+      }
+
+      promise.resolve(mapOf("width" to width, "height" to height))
+    } catch (e: Exception) {
+      promise.reject("VIDEO_METADATA_ERROR", "Failed to read video metadata: ${e.message}", e)
+    } finally {
+      retriever.release()
+    }
   }
 
