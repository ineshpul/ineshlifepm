rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Leap uploads use `videos/{uid}/{challengeDate}/{file}` — tie reads to Firestore approval (or owner).
    match /videos/{userId}/{challengeDate}/{fileName} {
      function videoFirestoreId() {
        return userId + '_' + challengeDate;
      }

      function videoIsApprovedInFirestore() {
        return firestore.exists(/databases/(default)/documents/videos/$(videoFirestoreId()))
          && firestore.get(/databases/(default)/documents/videos/$(videoFirestoreId())).data.moderationStatus
            == 'approved';
      }

      function leapMetaKeyStorage() {
        return firestore.get(/databases/(default)/documents/config/leapViewing).data.viewingChallengeDateKey;
      }

      function calendarMetaKeyStorage() {
        return firestore.get(/databases/(default)/documents/config/leapViewing).data.nyCalendarDateKey;
      }

      function hasVideoForUidDateStorage(uid, dateKey) {
        return firestore.exists(/databases/(default)/documents/videos/$(uid + '_' + dateKey))
          && firestore.get(/databases/(default)/documents/videos/$(uid + '_' + dateKey)).data.uid == uid;
      }

      function viewerPostedCurrentLeapStorage() {
        return firestore.exists(/databases/(default)/documents/config/leapViewing)
          && (
            hasVideoForUidDateStorage(request.auth.uid, leapMetaKeyStorage())
            || (
              firestore.get(/databases/(default)/documents/config/leapViewing).data.keys().hasAny(['nyCalendarDateKey'])
              && hasVideoForUidDateStorage(request.auth.uid, calendarMetaKeyStorage())
            )
          );
      }

      function requestUserIsAdmin() {
        return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      function requestUserIsModerator() {
        return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isModerator == true;
      }

      function requestUserIsStaff() {
        return requestUserIsAdmin() || requestUserIsModerator();
      }

      // Approved leap videos: signed-in users may stream (feed preview + full feed). App still gates UX.
      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || requestUserIsStaff()
          || videoIsApprovedInFirestore()
        );

      allow write: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null
        && (
          request.auth.uid == userId
          || requestUserIsStaff()
        );
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Chat media: only conversation members may read; only the uploader may write their path.
    match /chat/{conversationId}/{uploaderUid}/{allPaths=**} {
      function isChatConvMember() {
        return request.auth != null
          && firestore.exists(/databases/(default)/documents/conversations/$(conversationId))
          && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberIds;
      }

      allow read: if isChatConvMember();
      allow write, delete: if isChatConvMember() && request.auth.uid == uploaderUid;
    }

    // Best part of your day media — owner write; public read when Firestore doc is public.
    match /bestParts/{userId}/{dateKey}/{fileName} {
      function bestPartDocId() {
        return userId + '_' + dateKey;
      }

      function bestPartPublicInFirestore() {
        return firestore.exists(/databases/(default)/documents/bestParts/$(bestPartDocId()))
          && firestore.get(/databases/(default)/documents/bestParts/$(bestPartDocId())).data.deleted != true
          && firestore.get(/databases/(default)/documents/bestParts/$(bestPartDocId())).data.isPrivate != true
          && firestore.get(/databases/(default)/documents/bestParts/$(bestPartDocId())).data.uid == userId;
      }

      function requestUserIsStaffBest() {
        return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isModerator == true
          );
      }

      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || requestUserIsStaffBest()
          || bestPartPublicInFirestore()
        );

      allow write: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null
        && (
          request.auth.uid == userId
          || requestUserIsStaffBest()
        );
    }

    // Admin analytics exports (auto-updated at end of each leap day).
    match /exports/{fileName} {
      function requestUserIsAdminExport() {
        return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      allow read: if requestUserIsAdminExport();
      allow write: if false;
    }
  }
}
