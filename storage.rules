rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Leap uploads use `videos/{uid}/{challengeDate}/{file}` — tie reads to Firestore approval (or owner).
    match /videos/{userId}/{challengeDate}/{fileName} {
      function videoFirestoreId() {
        return userId + '_' + challengeDate;
      }

      function videoIsApprovedInFirestore() {
        return firestore.exists(/databases/(default)/documents/videos/$(videoFirestoreId()))
          && firestore.get(/databases/(default)/documents/videos/$(videoFirestoreId())).data.moderationStatus
            == 'approved';
      }

      function requestUserIsAdmin() {
        return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      function requestUserIsModerator() {
        return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isModerator == true;
      }

      function requestUserIsStaff() {
        return requestUserIsAdmin() || requestUserIsModerator();
      }

      allow read: if request.auth != null
        && (
          request.auth.uid == userId
          || videoIsApprovedInFirestore()
          || requestUserIsStaff()
        );

      allow write: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null
        && (
          request.auth.uid == userId
          || requestUserIsStaff()
        );
    }

    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Chat media: path includes uploader uid so only they can write; reads require auth (URLs stay unguessable).
    match /chat/{conversationId}/{uploaderUid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == uploaderUid;
    }
  }
}
