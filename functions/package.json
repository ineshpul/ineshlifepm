{
  "name": "leap-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "backfill:leap": "npm run build && node lib/runBackfillLeapLeaperPointsScript.js",
    "backfill:weekly": "npm run build && node lib/runBackfillWeeklyLeaperWeekScript.js",
    "backfill:identity": "npm run build && node lib/runBackfillUserIdentityScript.js",
    "heal:first-post": "npm run build && node lib/runHealGlobalFirstPostScript.js",
    "recompute:all": "npm run build && node lib/runRecomputeAllVerticalScoresScript.js",
    "dedupe:usernames": "npm run build && node lib/scripts/dedupeUsernames.js",
    "dedupe:usernames:execute": "npm run build && node lib/scripts/dedupeUsernames.js --execute",
    "backfill:username-lower": "npm run build && node lib/scripts/backfillUsernameLower.js",
    "backfill:username-lower:execute": "npm run build && node lib/scripts/backfillUsernameLower.js --execute",
    "reset:recording-attempts": "npm run build && node lib/runResetRecordingAttemptsForLeapDayScript.js",
    "reset:recording-attempts:user": "npm run build && node lib/runResetRecordingAttemptsForUserScript.js",
    "heal:leap-day": "npm run build && node lib/runHealLeapDayPostAndAttemptsScript.js",
    "check:referral": "npm run build && node lib/runReferralRewardsSelfCheck.js",
    "heal:stale-streaks": "npm run build && node lib/runHealStaleStreaksScript.js",
    "test:inches": "npm run build && node lib/runInchCountingTestScript.js",
    "grant:app-review": "npm run build && node lib/scripts/grantAppReviewAccess.js",
    "allow:repost": "npm run build && node lib/scripts/allowRepostToday.js",
    "grant:late-post": "npm run build && node lib/scripts/grantLatePostGrace.js",
    "grant:leap-extension": "npm run build && node lib/scripts/grantLeapDayExtension.js",
    "clear:leap-extension": "npm run build && node lib/scripts/clearLeapDayExtensions.js",
    "heal:streak-continuation": "npm run build && node lib/scripts/healStreakContinuation.js",
    "export:challenge-posts": "npm run build && node lib/scripts/exportChallengePostStats.js",
    "export:challenge-posts:upload": "npm run build && node lib/scripts/exportChallengePostStats.js --upload",
    "download:challenge-posts": "npm run build && node lib/scripts/downloadChallengePostStats.js",
    "open:challenge-posts": "npm run build && node lib/scripts/openChallengePostStats.js",
    "backfill:faststart": "npm run build && node lib/runBackfillFaststartScript.js"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-storage": "^3.758.0",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
