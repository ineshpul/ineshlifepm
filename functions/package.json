{
  "name": "leap-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "backfill:leap": "npm run build && node lib/runBackfillLeapLeaperPointsScript.js",
    "dedupe:usernames": "npm run build && node lib/scripts/dedupeUsernames.js",
    "dedupe:usernames:execute": "npm run build && node lib/scripts/dedupeUsernames.js --execute"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
