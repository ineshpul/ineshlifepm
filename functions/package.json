{
  "name": "leap-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "backfill:leap": "npm run build && node lib/runBackfillLeapLeaperPointsScript.js",
    "backfill:weekly": "npm run build && node lib/runBackfillWeeklyLeaperWeekScript.js",
    "backfill:identity": "npm run build && node lib/runBackfillUserIdentityScript.js",
    "heal:first-post": "npm run build && node lib/runHealGlobalFirstPostScript.js",
    "recompute:all": "npm run build && node lib/runRecomputeAllVerticalScoresScript.js",
    "dedupe:usernames": "npm run build && node lib/scripts/dedupeUsernames.js",
    "dedupe:usernames:execute": "npm run build && node lib/scripts/dedupeUsernames.js --execute",
    "reset:recording-attempts": "npm run build && node lib/runResetRecordingAttemptsForLeapDayScript.js"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-storage": "^3.758.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
