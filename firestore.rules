rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isModerator', false) == true;
    }

    function isStaff() {
      return isAdmin() || isModerator();
    }

    function viewerFollowsUser(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(userId));
    }

    /** Owner, staff, public profile, or follower when `privateAccount` is true. */
    function canViewUserProfile(userId) {
      return isOwner(userId)
        || isStaff()
        || get(/databases/$(database)/documents/users/$(userId)).data.get('privateAccount', false) != true
        || viewerFollowsUser(userId);
    }

    function profileMessageAudience(userId) {
      let data = get(/databases/$(database)/documents/users/$(userId)).data;
      return data.keys().hasAny(['whoCanMessage']) && data.whoCanMessage == 'friends'
        ? 'friends'
        : (
          data.keys().hasAny(['chatMessageAudience']) && data.chatMessageAudience == 'friends'
            ? 'friends'
            : 'everyone'
        );
    }

    function canMessageUser(targetUid) {
      return request.auth.uid == targetUid
        || isStaff()
        || profileMessageAudience(targetUid) != 'friends'
        || viewerFollowsUser(targetUid);
    }

    function videoOwnerUid(videoId) {
      return videoDoc(videoId).uid;
    }

    function canCommentOnVideo(videoId) {
      let owner = videoOwnerUid(videoId);
      return request.auth.uid == owner
        || get(/databases/$(database)/documents/users/$(owner)).data.get('whoCanComment', 'everyone') != 'friends'
        || viewerFollowsUser(owner);
    }

    /** Doc id in `usernameClaims` — normalized client-side; max 40 (allows `_` and `-` for legacy rows). */
    function validUsernameClaimKey(k) {
      return k is string
        && k.size() >= 1
        && k.size() <= 40
        && k.matches('^[a-z0-9_-]+$');
    }

    function validFeedTeaserCardLimit(v) {
      return v is int && v >= 10 && v <= 20;
    }

    function validExperimentCohort(v) {
      return v == 'gate_on' || v == 'gate_off';
    }

    /** One-time write of `users/{uid}.feedTeaserCardLimit` by the account owner. */
    function isOneTimeFeedTeaserLimitWrite() {
      return !resource.data.keys().hasAny(['feedTeaserCardLimit'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedTeaserCardLimit'])
        && validFeedTeaserCardLimit(request.resource.data.feedTeaserCardLimit);
    }

    /** One-time write of `users/{uid}.feedGraduationSeenAt` by the account owner. */
    function isOneTimeFeedGraduationSeenWrite() {
      return !resource.data.keys().hasAny(['feedGraduationSeenAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['feedGraduationSeenAt']);
    }

    /** One-time experiment cohort assignment (never overwrite). */
    function isOneTimeExperimentCohortWrite() {
      return !resource.data.keys().hasAny(['experimentCohort'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['experimentCohort', 'experimentAssignedAt'])
        && validExperimentCohort(request.resource.data.experimentCohort)
        && request.resource.data.experimentAssignedAt == request.time;
    }

    /** Experiment analytics fields — owner may set only after cohort assignment. */
    function isExperimentAnalyticsWrite() {
      return resource.data.keys().hasAny(['experimentCohort'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'experimentDay1Returned',
          'experimentDay7Returned',
          'experimentTotalSessionSeconds',
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['experimentDay1Returned'])
          || (
            request.resource.data.experimentDay1Returned == true
            && resource.data.get('experimentDay1Returned', false) != true
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['experimentDay7Returned'])
          || (
            request.resource.data.experimentDay7Returned == true
            && resource.data.get('experimentDay7Returned', false) != true
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['experimentTotalSessionSeconds'])
          || (
            request.resource.data.experimentTotalSessionSeconds is int
            && request.resource.data.experimentTotalSessionSeconds >= 0
            && request.resource.data.experimentTotalSessionSeconds
              >= resource.data.get('experimentTotalSessionSeconds', 0)
          )
        );
    }

    function ownsUsernameClaimForUser(userId, key) {
      return signedIn()
        && validUsernameClaimKey(key)
        && exists(/databases/$(database)/documents/usernameClaims/$(key))
        && get(/databases/$(database)/documents/usernameClaims/$(key)).data.uid == userId;
    }

    /** Matches client noon→noon cycle; maintained by `scheduledLeapViewingMeta` Cloud Function. */
    function leapMetaKey() {
      return get(/databases/$(database)/documents/config/leapViewing).data.viewingChallengeDateKey;
    }

    /** NY calendar day (midnight roll) — may differ from leap key before noon ET; used to match older/calendar `challengeDate` posts. */
    function calendarMetaKey() {
      return get(/databases/$(database)/documents/config/leapViewing).data.nyCalendarDateKey;
    }

    function hasVideoForUidAndDateKey(uid, dateKey) {
      return dateKey is string
        && dateKey.size() > 0
        && exists(/databases/$(database)/documents/videos/$(uid + '_' + dateKey))
        && get(/databases/$(database)/documents/videos/$(uid + '_' + dateKey)).data.uid == uid;
    }

    /** True if the viewer has a post whose doc id matches leap and/or calendar keys (covers legacy date mismatches). */
    function viewerPostedCurrentLeap() {
      return exists(/databases/$(database)/documents/config/leapViewing)
        && (
          hasVideoForUidAndDateKey(request.auth.uid, leapMetaKey())
          || (
            get(/databases/$(database)/documents/config/leapViewing).data.keys().hasAny(['nyCalendarDateKey'])
            && hasVideoForUidAndDateKey(request.auth.uid, calendarMetaKey())
          )
        );
    }

    /** Any signed-in user may read approved video metadata (leaperboard, profiles). Playback is gated in Storage + app. */
    function canReadApprovedVideoMetadata() {
      return signedIn();
    }

    function videoDoc(videoId) {
      return get(/databases/$(database)/documents/videos/$(videoId)).data;
    }

    function canReadVideoDoc(videoId) {
      return signedIn()
        && exists(/databases/$(database)/documents/videos/$(videoId))
        && (
          isStaff()
          || videoDoc(videoId).uid == request.auth.uid
          || (
            videoDoc(videoId).moderationStatus == 'approved'
            && canReadApprovedVideoMetadata()
          )
        );
    }

    // --- Chat (conversations, members, messages, reactions, typing) ---
    function convDoc(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data;
    }

    function isConvMember(convId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(convId))
        && request.auth.uid in convDoc(convId).memberIds;
    }

    function canDm() {
      return signedIn();
    }

    function dmOtherMemberId(memberIds) {
      return memberIds[0] == request.auth.uid ? memberIds[1] : memberIds[0];
    }

    function isBlockedPair(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/userBlocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/userBlocks/$(a));
    }

    function validMessageText(t) {
      return t is string && t.size() >= 0 && t.size() <= 4000;
    }

    function validAttachments(atts) {
      return atts == null
        || (atts is list && atts.size() <= 4);
    }

    match /conversations/{convId} {
      // Allow read when missing so `getDoc()` can safely check existence before create.
      // Without this, clients cannot "get or create" a deterministic DM id.
      allow read: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(convId))
          || isConvMember(convId)
        );

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.memberCount == request.resource.data.memberIds.size()
        && request.resource.data.type in ['dm', 'group']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && (
          (
            request.resource.data.type == 'dm'
            && request.resource.data.memberIds.size() == 2
            && request.resource.data.dmPairKey is string
            && canDm()
            && canMessageUser(dmOtherMemberId(request.resource.data.memberIds))
            && !isBlockedPair(
              request.resource.data.memberIds[0],
              request.resource.data.memberIds[1]
            )
          )
          || (request.resource.data.type == 'group')
        );

      allow update: if signedIn()
        && isConvMember(convId)
        // Members may only update activity metadata; never membership or creator fields.
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.type == resource.data.type
        && request.resource.data.dmPairKey == resource.data.dmPairKey
        && request.resource.data.memberCount == resource.data.memberCount
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt', 'lastActivityAt', 'lastMessage']);

      allow delete: if false;

      match /conversationMembers/{userId} {
        allow read: if signedIn() && isConvMember(convId);

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/conversations/$(convId))
          && request.auth.uid in convDoc(convId).memberIds
          && (
            // Creator can bootstrap all member rows.
            convDoc(convId).createdBy == request.auth.uid
            // Any member can (re)create their own member row if missing.
            || request.auth.uid == userId
          )
          && request.resource.data.memberUid == userId;

        // Self: prefs, read receipts, DM title/avatar refresh, or own row after send (unread -> 0).
        // Others: only inbox bump fields from sendMessage (+1 unread), never arbitrary edits.
        function memberPrevUnread() {
          return resource.data.unreadCount is int ? resource.data.unreadCount : 0;
        }

        function memberSelfPrefsDelta() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['muted', 'archived', 'pinned', 'chatNotificationsEnabled']);
        }

        function memberMarkReadDelta() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCount', 'lastReadMessageId', 'lastReadAt']);
        }

        function memberDmTitlesDelta() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['convTitle', 'convAvatarUrl']);
        }

        function memberOwnSendRowDelta() {
          return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastActivityAt', 'lastMessagePreview', 'unreadCount'])
            && request.resource.data.unreadCount == 0;
        }

        function memberPeerInboxBumpDelta() {
          return request.auth.uid != userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastActivityAt', 'lastMessagePreview', 'unreadCount'])
            && request.resource.data.unreadCount is int
            && request.resource.data.unreadCount == memberPrevUnread() + 1;
        }

        allow update: if signedIn() && isConvMember(convId)
          && (
            (
              request.auth.uid == userId
              && (
                memberSelfPrefsDelta()
                || memberMarkReadDelta()
                || memberDmTitlesDelta()
                || memberOwnSendRowDelta()
              )
            )
            || memberPeerInboxBumpDelta()
          );

        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && isConvMember(convId);

        allow create: if signedIn()
          && isConvMember(convId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == convId
          && validMessageText(request.resource.data.text)
          && validMessageText(request.resource.data.searchText)
          && validAttachments(request.resource.data.attachments)
          && (
            !request.resource.data.keys().hasAny(['kind'])
            || request.resource.data.kind in ['text', 'system', 'share_post']
          )
          && (
            !request.resource.data.keys().hasAny(['deletedForEveryone'])
            || request.resource.data.deletedForEveryone == false
          );

        allow update: if signedIn()
          && isConvMember(convId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'searchText', 'editedAt', 'deletedForSelfUids']);

        allow delete: if false;

        match /messageReactions/{reactionId} {
          allow read: if signedIn() && isConvMember(convId);
          allow create: if signedIn()
            && isConvMember(convId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.emoji is string
            && request.resource.data.emoji.size() > 0
            && request.resource.data.emoji.size() < 32;
          allow delete: if signedIn() && isConvMember(convId) && resource.data.userId == request.auth.uid;
          allow update: if false;
        }
      }

      match /typing/{userId} {
        allow read: if signedIn() && isConvMember(convId);
        allow create, update: if signedIn() && isConvMember(convId) && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /userPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /messageReports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.conversationId is string
        && request.resource.data.messageId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() < 500;
      allow update, delete: if false;
    }

    match /videoReports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.videoOwnerUid is string
        && request.resource.data.videoOwnerUsername is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() < 500;
      allow update, delete: if false;
    }

    // Active leap cycle key (noon→noon ET) — used only by security rules for feed/video access.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    /** Global first-approved-of-day bookkeeping (Cloud Functions only). */
    match /dailyChallengeStats/{dayKey} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Daily post is unique per user per challenge day (doc id `${uid}_${challengeDate}`).
    // `pending` posts: owner + staff read; others only after `approved`. Leap inches while pending
    // are written by Cloud Functions (not client-writable fields on create).
    match /videos/{videoId} {
      // Allow read when the doc is missing so `onSnapshot` (e.g. “posted today?”) does not throw
      // permission-denied — `resource.data` is not valid if the document does not exist.
      allow read: if signedIn()
        && (
          !exists(/databases/$(database)/documents/videos/$(videoId))
          || isStaff()
          || resource.data.uid == request.auth.uid
          || (
            resource.data.moderationStatus == 'approved'
            && canReadApprovedVideoMetadata()
          )
        );

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && videoId == request.resource.data.uid + '_' + request.resource.data.challengeDate
        // Instant approve is allowed (product policy); still validate shape + storage ownership.
        && (
          request.resource.data.moderationStatus == 'pending'
          || request.resource.data.moderationStatus == 'approved'
        )
        && (
          (
            !('photoUrl' in request.resource.data)
            && request.resource.data.keys().hasOnly([
              'uid',
              'username',
              'challengeDate',
              'challengeTitle',
              'challengeSubtitle',
              'prompt',
              'maxDurationSeconds',
              'source',
              'url',
              'storagePath',
              // Optional companion PIP clip URL + storage path for BeReal-style dual-camera posts.
              'secondaryUrl',
              'secondaryStoragePath',
              'dualFrontIsPrimary',
              'moderationStatus',
              'createdAt',
              'viewCount',
              'likesCount',
              'commentsCount',
              'shareCount',
              'saveCount',
              'reportCount',
              'deleted',
              'challengeCompleted',
            ])
          )
          || (
            'photoUrl' in request.resource.data
            && request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() > 0
            && request.resource.data.photoUrl.size() < 2048
            && request.resource.data.keys().hasOnly([
              'uid',
              'username',
              'photoUrl',
              'challengeDate',
              'challengeTitle',
              'challengeSubtitle',
              'prompt',
              'maxDurationSeconds',
              'source',
              'url',
              'storagePath',
              // Optional companion PIP clip URL + storage path for BeReal-style dual-camera posts.
              'secondaryUrl',
              'secondaryStoragePath',
              'dualFrontIsPrimary',
              'moderationStatus',
              'createdAt',
              'viewCount',
              'likesCount',
              'commentsCount',
              'shareCount',
              'saveCount',
              'reportCount',
              'deleted',
              'challengeCompleted',
            ])
          )
        )
        // Either both PIP fields are present (and valid) or both are absent.
        && (
          (
            !('secondaryUrl' in request.resource.data)
            && !('secondaryStoragePath' in request.resource.data)
          )
          || (
            'secondaryUrl' in request.resource.data
            && 'secondaryStoragePath' in request.resource.data
            && request.resource.data.secondaryUrl is string
            && request.resource.data.secondaryUrl.size() > 0
            && request.resource.data.secondaryUrl.size() < 2048
            && request.resource.data.secondaryStoragePath is string
            && request.resource.data.secondaryStoragePath.matches(
              '^videos/' + request.auth.uid + '/' + request.resource.data.challengeDate + '/[^/]+$'
            )
            && (
              !('dualFrontIsPrimary' in request.resource.data)
              || request.resource.data.dualFrontIsPrimary == true
            )
          )
        )
        && (
          !('dualFrontIsPrimary' in request.resource.data)
          || (
            'secondaryUrl' in request.resource.data
            && 'secondaryStoragePath' in request.resource.data
          )
        )
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() < 64
        && request.resource.data.challengeDate is string
        && request.resource.data.challengeDate.size() > 0
        && request.resource.data.challengeDate.size() < 40
        && request.resource.data.challengeTitle is string
        && request.resource.data.challengeTitle.size() < 500
        && request.resource.data.challengeSubtitle is string
        && request.resource.data.challengeSubtitle.size() < 2000
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() < 500
        && request.resource.data.source is string
        && request.resource.data.source.size() < 64
        && request.resource.data.url is string
        && request.resource.data.url.size() > 0
        && request.resource.data.url.size() < 2048
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches(
          '^videos/' + request.auth.uid + '/' + request.resource.data.challengeDate + '/[^/]+$'
        )
        && request.resource.data.maxDurationSeconds is int
        && request.resource.data.maxDurationSeconds > 0
        && request.resource.data.maxDurationSeconds < 600
        && request.resource.data.viewCount == 0
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.shareCount == 0
        && request.resource.data.saveCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.deleted == false
        && request.resource.data.challengeCompleted == true
        && request.resource.data.createdAt is timestamp;

      allow update: if isStaff()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationStatus'])
        && request.resource.data.moderationStatus in ['approved', 'pending', 'rejected', 'nulled'];
      allow delete: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);

      // Server-managed throttling ledger for view counting (callable uses Admin SDK).
      match /viewMarks/{viewerId} {
        allow read, write: if false;
      }

      // Server-only view counter (kept off the main doc to avoid feed snapshot churn).
      match /private/stats {
        allow read, write: if false;
      }

      match /likes/{likerId} {
        allow read: if canReadVideoDoc(videoId);
        allow create: if canReadVideoDoc(videoId) && signedIn() && request.auth.uid == likerId;
        allow delete: if signedIn()
          && (
            request.auth.uid == likerId
            || (
              exists(/databases/$(database)/documents/videos/$(videoId))
              && get(/databases/$(database)/documents/videos/$(videoId)).data.uid == request.auth.uid
            )
            || isStaff()
          );
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if canReadVideoDoc(videoId);
        allow create: if canReadVideoDoc(videoId)
          && signedIn()
          && canCommentOnVideo(videoId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 500;
        allow delete: if signedIn()
          && exists(/databases/$(database)/documents/videos/$(videoId))
          && (
            isStaff()
            || get(/databases/$(database)/documents/videos/$(videoId)).data.uid == request.auth.uid
            || resource.data.uid == request.auth.uid
          );
        allow update: if false;

        match /likes/{likerId} {
          allow read: if canReadVideoDoc(videoId);
          allow create: if canReadVideoDoc(videoId) && signedIn() && request.auth.uid == likerId;
          allow delete: if signedIn() && request.auth.uid == likerId;
          allow update: if false;
        }
      }
    }

    // Attempt ledger for enforcing max tries + coordinating with unique video doc id.
    match /postAttempts/{attemptId} {
      allow read: if signedIn() && attemptId.matches('^' + request.auth.uid + '_.+');

      function attemptDocIdMatchesFields() {
        return attemptId == request.resource.data.uid + '_' + request.resource.data.challengeDate;
      }

      function postAttemptLedgerKeys() {
        return request.resource.data.keys().hasAll(['uid', 'challengeDate', 'used', 'max', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
            'uid',
            'challengeDate',
            'used',
            'max',
            'updatedAt',
            'bonusRecordingAttempts',
            'leapBaseReductionInches',
          ])
          && (
            !request.resource.data.keys().hasAny(['bonusRecordingAttempts'])
            || (
              request.resource.data.bonusRecordingAttempts is int
              && request.resource.data.bonusRecordingAttempts >= 0
            )
          )
          && (
            !request.resource.data.keys().hasAny(['leapBaseReductionInches'])
            || (
              request.resource.data.leapBaseReductionInches is int
              && request.resource.data.leapBaseReductionInches >= 0
              && request.resource.data.leapBaseReductionInches <= 50
            )
          );
      }

      function prevUsedCount() {
        return resource.data.used is int ? resource.data.used : 0;
      }

      function prevBonusCount() {
        return resource.data.keys().hasAll(['bonusRecordingAttempts'])
          && resource.data.bonusRecordingAttempts is int
          ? resource.data.bonusRecordingAttempts
          : 0;
      }

      function maxRecordingAttemptsForChallengeDate(dateKey) {
        return (!exists(/databases/$(database)/documents/challenges/$(dateKey))
          || !(get(/databases/$(database)/documents/challenges/$(dateKey)).data.keys().hasAny(['maxRecordingAttempts']))
          || !(get(/databases/$(database)/documents/challenges/$(dateKey)).data.maxRecordingAttempts is int)
          || get(/databases/$(database)/documents/challenges/$(dateKey)).data.maxRecordingAttempts < 1
          || get(/databases/$(database)/documents/challenges/$(dateKey)).data.maxRecordingAttempts > 50)
          ? 3
          : get(/databases/$(database)/documents/challenges/$(dateKey)).data.maxRecordingAttempts;
      }

      function ledgerMaxCap() {
        return maxRecordingAttemptsForChallengeDate(request.resource.data.challengeDate);
      }

      // Missing, soft-deleted, or rejected/nulled — does not block recording-attempt refund/reset.
      // Active posts still block (prevents wiping the ledger while a live leap exists).
      function leapVideoMissingOrInactive() {
        return !exists(/databases/$(database)/documents/videos/$(attemptId))
          || get(/databases/$(database)/documents/videos/$(attemptId)).data.deleted == true
          || get(/databases/$(database)/documents/videos/$(attemptId)).data.moderationStatus in [
            'rejected',
            'nulled',
          ];
      }

      allow create: if signedIn()
        && attemptId.matches('^' + request.auth.uid + '_.+')
        && attemptDocIdMatchesFields()
        && request.resource.data.uid == request.auth.uid
        && postAttemptLedgerKeys()
        && request.resource.data.challengeDate is string
        && request.resource.data.used is int
        && request.resource.data.used >= 0
        && request.resource.data.used <= ledgerMaxCap()
        && request.resource.data.max is int
        && request.resource.data.max == ledgerMaxCap()
        && request.resource.data.updatedAt is timestamp;

      allow update: if signedIn()
        && attemptId.matches('^' + request.auth.uid + '_.+')
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.challengeDate == resource.data.challengeDate
        && postAttemptLedgerKeys()
        && request.resource.data.max is int
        && request.resource.data.max == ledgerMaxCap()
        && request.resource.data.used is int
        && request.resource.data.used >= 0
        && request.resource.data.used <= request.resource.data.max
        && (
          request.resource.data.used == prevUsedCount() + 1
          || (
            request.resource.data.used == prevUsedCount() - 1
            && leapVideoMissingOrInactive()
          )
          || (
            request.resource.data.used == request.resource.data.max
            && prevUsedCount() < request.resource.data.max
          )
          || (
            request.resource.data.used == prevUsedCount()
            && prevBonusCount() > 0
            && (
              (
                request.resource.data.keys().hasAll(['bonusRecordingAttempts'])
                && request.resource.data.bonusRecordingAttempts is int
                && request.resource.data.bonusRecordingAttempts == prevBonusCount() - 1
              )
              || (
                prevBonusCount() == 1
                && !request.resource.data.keys().hasAny(['bonusRecordingAttempts'])
              )
            )
          )
          || (
            request.resource.data.used == request.resource.data.max
            && resource.data.used == request.resource.data.used
          )
          || (
            (
              isStaff()
              || leapVideoMissingOrInactive()
            )
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.used == 0
            && request.resource.data.max is int
            && request.resource.data.max == ledgerMaxCap()
          )
        );

      // Only when the daily video is gone or inactive (delete/reject flow).
      allow delete: if signedIn()
        && attemptId.matches('^' + request.auth.uid + '_.+')
        && leapVideoMissingOrInactive();
    }

    /** One doc per normalized username; `uid` is the account that owns the handle. */
    match /usernameClaims/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validUsernameClaimKey(key)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernameClaims/$(key));
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      // Single-profile fetch: respect private account / followers.
      allow get: if canViewUserProfile(userId);
      // Collection queries (leaperboard, search, batch lookups) — Firestore cannot prove
      // per-doc `canViewUserProfile` for every row in an orderBy query; staff-only get would
      // break TopScreen for normal users.
      allow list: if signedIn();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'isModerator',
          'bypassFeedGate',
          'email',
          'verticalScore',
          'verticalScoreBreakdown',
          'verticalScoreUpdatedAt',
          'verticalScoreAdjustment',
          'lifetimeVerticalXP',
          'activeLeapStreakDays',
          'longestLeapStreakDays',
          'lastApprovedLeapDateKey',
          'recentQualityAvg',
          'recentApprovedLeapCount',
          'inactivityDecay',
          'safetyPenalty',
          'hasReceivedFirstLeapBonus',
          'bestVerticalGainPostId',
          'bestVerticalGainPoints',
          'highestJumpDisplayInches',
          'leaperDayKey',
          'leaperDayPoints',
          'leaperWeekKey',
          'leaperWeekPoints',
          'leaperLifetimePoints',
          'referredByUid',
          'referredAt',
          'feedTeaserCardLimit',
          'feedGraduationSeenAt',
          'experimentCohort',
          'experimentAssignedAt',
          'experimentDay1Returned',
          'experimentDay7Returned',
          'experimentTotalSessionSeconds',
        ])
        && (
          !request.resource.data.keys().hasAny(['usernameLower'])
          || ownsUsernameClaimForUser(userId, request.resource.data.usernameLower)
        );
      allow update: if isOwner(userId)
        && (
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'isAdmin',
              'isModerator',
              'bypassFeedGate',
              'email',
              'verticalScore',
              'verticalScoreBreakdown',
              'verticalScoreUpdatedAt',
              'verticalScoreAdjustment',
              'lifetimeVerticalXP',
              'activeLeapStreakDays',
              'longestLeapStreakDays',
              'lastApprovedLeapDateKey',
              'recentQualityAvg',
              'recentApprovedLeapCount',
              'inactivityDecay',
              'safetyPenalty',
              'hasReceivedFirstLeapBonus',
              'bestVerticalGainPostId',
              'bestVerticalGainPoints',
              'highestJumpDisplayInches',
              'leaperDayKey',
              'leaperDayPoints',
              'leaperWeekKey',
              'leaperWeekPoints',
              'leaperLifetimePoints',
              'referredByUid',
              'referredAt',
              'feedTeaserCardLimit',
              'feedGraduationSeenAt',
              'experimentCohort',
              'experimentAssignedAt',
              'experimentDay1Returned',
              'experimentDay7Returned',
              'experimentTotalSessionSeconds',
            ])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'usernameLower'])
              || (
                request.resource.data.username == resource.data.username
                && request.resource.data.usernameLower == resource.data.usernameLower
              )
              || ownsUsernameClaimForUser(userId, request.resource.data.usernameLower)
            )
          )
          || isOneTimeFeedTeaserLimitWrite()
          || isOneTimeFeedGraduationSeenWrite()
          || isOneTimeExperimentCohortWrite()
          || isExperimentAnalyticsWrite()
        );
      allow delete: if false;

      // Private user data (PII). Owner-only.
      match /private/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // In-app inbox (likes / comments / follows / moderation). Recipient reads; actors create social
      // rows only — moderation types are created by Cloud Functions (Admin SDK).
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type in ['like', 'comment', 'follow', 'mention']
          && request.resource.data.fromUsername is string
          && request.resource.data.read == false
          && request.auth.uid != userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Who you follow — owner always; others when `showFollowingListToOthers` is not false (default on).
      match /following/{targetUid} {
        allow read: if isOwner(userId)
          || (signedIn()
            && get(/databases/$(database)/documents/users/$(userId)).data.get('showFollowingListToOthers', true) != false);
        // `targetPhotoUrl` is optional denormalized public avatar for list UIs (synced from `users/{targetUid}.photoUrl`).
        allow create: if isOwner(userId)
          && request.auth.uid == userId
          && userId != targetUid
          && request.resource.data.targetUsername is string
          && (
            request.resource.data.keys().hasOnly(['targetUsername', 'createdAt'])
            || (
              request.resource.data.keys().hasOnly(['targetUsername', 'createdAt', 'targetPhotoUrl'])
              && (
                request.resource.data.targetPhotoUrl == null
                || request.resource.data.targetPhotoUrl is string
              )
            )
          );
        allow delete: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['targetUsername', 'createdAt', 'targetPhotoUrl'])
          && request.resource.data.targetUsername is string
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            request.resource.data.targetPhotoUrl == null
            || request.resource.data.targetPhotoUrl is string
          );
      }

      // Expo push tokens for this user (one doc per device). Used by Cloud Functions only to send pushes.
      match /pushDevices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.token is string
          && request.resource.data.platform is string;
        allow delete: if isOwner(userId);
      }

      match /userBlocks/{blockedUid} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId) && userId != blockedUid;
        allow update: if false;
      }

      // Chat inbox mirror (doc id = conversation id). Any conversation member may upsert rows for members
      // so send/receive stays in sync; only the owner may read their list.
      match /chatConversations/{convId} {
        function inboxMirrorKeys() {
          return request.resource.data.keys().hasOnly([
            'conversationId',
            'memberUid',
            'convTitle',
            'convAvatarUrl',
            'convType',
            'displayNameSnap',
            'role',
            'joinedAt',
            'muted',
            'archived',
            'pinned',
            'unreadCount',
            'lastReadMessageId',
            'lastReadAt',
            'lastActivityAt',
            'lastMessagePreview',
            'chatNotificationsEnabled',
          ]);
        }

        allow read: if isOwner(userId);

        allow create, update: if signedIn()
          && exists(/databases/$(database)/documents/conversations/$(convId))
          && request.auth.uid in convDoc(convId).memberIds
          && userId in convDoc(convId).memberIds
          && request.resource.data.conversationId == convId
          && request.resource.data.memberUid == userId
          && inboxMirrorKeys();

        allow delete: if false;
      }
    }

    // Server-only (Cloud Functions admin SDK). Holds short-lived email sign-in OTPs + rate limits.
    match /loginOtps/{id} {
      allow read, write: if false;
    }

    match /loginOtpRate/{id} {
      allow read, write: if false;
    }

    match /challengeSuggestionRate/{id} {
      allow read, write: if false;
    }

    match /videoModerationJobs/{id} {
      allow read, write: if false;
    }

    match /referrals/{id} {
      allow read, write: if false;
    }

    match /referralGrants/{id} {
      allow read, write: if false;
    }

    match /challenges/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && (!request.resource.data.keys().hasAny(['maxRecordingAttempts'])
          || (request.resource.data.maxRecordingAttempts is int
            && request.resource.data.maxRecordingAttempts >= 1
            && request.resource.data.maxRecordingAttempts <= 50))
        && (!request.resource.data.keys().hasAny(['maxDurationSeconds'])
          || (request.resource.data.maxDurationSeconds is int
            && request.resource.data.maxDurationSeconds >= 10
            && request.resource.data.maxDurationSeconds <= 600));
      allow delete: if false;
    }

    /**
     * Best part of your day — ungated moments (photo/video + caption).
     * Doc id: `{uid}_{dateKey}` (NY calendar day). Private posts are owner/staff only.
     */
    match /bestParts/{bestPartId} {
      function bestPartDateKeyOk(k) {
        return k is string && k.matches('^\\d{4}-\\d{2}-\\d{2}$');
      }

      function bestPartCreateKeysOk() {
        return request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'photoUrl',
          'dateKey',
          'caption',
          'mediaType',
          'url',
          'storagePath',
          'secondaryUrl',
          'secondaryStoragePath',
          'dualFrontIsPrimary',
          'durationSeconds',
          'isPrivate',
          'deleted',
          'likesCount',
          'commentsCount',
          'createdAt',
          'updatedAt',
        ]);
      }

      function bestPartShapeOk() {
        return request.resource.data.uid == request.auth.uid
          && bestPartId == request.resource.data.uid + '_' + request.resource.data.dateKey
          && bestPartDateKeyOk(request.resource.data.dateKey)
          && request.resource.data.username is string
          && request.resource.data.username.size() >= 1
          && request.resource.data.username.size() <= 40
          && request.resource.data.caption is string
          && request.resource.data.caption.size() >= 1
          && request.resource.data.caption.size() <= 280
          && (request.resource.data.mediaType == 'photo' || request.resource.data.mediaType == 'video')
          && request.resource.data.url is string
          && request.resource.data.url.size() > 0
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches(
            '^bestParts/' + request.auth.uid + '/' + request.resource.data.dateKey + '/[^/]+$'
          )
          && request.resource.data.isPrivate is bool
          && request.resource.data.deleted is bool
          && request.resource.data.likesCount is int
          && request.resource.data.likesCount >= 0
          && request.resource.data.commentsCount is int
          && request.resource.data.commentsCount >= 0
          && (!('photoUrl' in request.resource.data)
            || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2000))
          && (!('durationSeconds' in request.resource.data)
            || (request.resource.data.durationSeconds is int
              && request.resource.data.durationSeconds >= 0
              && request.resource.data.durationSeconds <= 60))
          && (
            (
              !('secondaryUrl' in request.resource.data)
              && !('secondaryStoragePath' in request.resource.data)
              && !('dualFrontIsPrimary' in request.resource.data)
            )
            || (
              request.resource.data.mediaType == 'video'
              && request.resource.data.secondaryUrl is string
              && request.resource.data.secondaryUrl.size() > 0
              && request.resource.data.secondaryUrl.size() < 2048
              && request.resource.data.secondaryStoragePath is string
              && request.resource.data.secondaryStoragePath.matches(
                '^bestParts/' + request.auth.uid + '/' + request.resource.data.dateKey + '/[^/]+$'
              )
              && request.resource.data.dualFrontIsPrimary is bool
            )
          );
      }

      allow read: if signedIn()
        && (
          !exists(/databases/$(database)/documents/bestParts/$(bestPartId))
          || isStaff()
          || resource.data.uid == request.auth.uid
          || (
            resource.data.deleted != true
            && resource.data.isPrivate != true
          )
        );

      allow create: if signedIn()
        && bestPartCreateKeysOk()
        && bestPartShapeOk()
        && request.resource.data.deleted == false
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && bestPartCreateKeysOk()
        && bestPartShapeOk()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.likesCount == resource.data.likesCount
        && request.resource.data.commentsCount == resource.data.commentsCount;

      allow delete: if false;

      function canEngageBestPart() {
        return signedIn()
          && exists(/databases/$(database)/documents/bestParts/$(bestPartId))
          && get(/databases/$(database)/documents/bestParts/$(bestPartId)).data.deleted != true
          && (
            isStaff()
            || get(/databases/$(database)/documents/bestParts/$(bestPartId)).data.uid == request.auth.uid
            || get(/databases/$(database)/documents/bestParts/$(bestPartId)).data.isPrivate != true
          );
      }

      match /likes/{likerId} {
        allow read: if canEngageBestPart();
        allow create: if canEngageBestPart() && request.auth.uid == likerId;
        allow delete: if signedIn()
          && (
            request.auth.uid == likerId
            || (
              exists(/databases/$(database)/documents/bestParts/$(bestPartId))
              && get(/databases/$(database)/documents/bestParts/$(bestPartId)).data.uid == request.auth.uid
            )
            || isStaff()
          );
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if canEngageBestPart();
        allow create: if canEngageBestPart()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 500;
        allow delete: if signedIn()
          && exists(/databases/$(database)/documents/bestParts/$(bestPartId))
          && (
            isStaff()
            || get(/databases/$(database)/documents/bestParts/$(bestPartId)).data.uid == request.auth.uid
            || resource.data.uid == request.auth.uid
          );
        allow update: if false;

        match /likes/{likerId} {
          allow read: if canEngageBestPart();
          allow create: if canEngageBestPart() && request.auth.uid == likerId;
          allow delete: if signedIn() && request.auth.uid == likerId;
          allow update: if false;
        }
      }
    }
  }
}
