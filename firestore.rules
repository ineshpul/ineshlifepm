rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function videoDoc(videoId) {
      return get(/databases/$(database)/documents/videos/$(videoId)).data;
    }

    function canReadVideoDoc(videoId) {
      return signedIn()
        && exists(/databases/$(database)/documents/videos/$(videoId))
        && (
          isAdmin()
          || videoDoc(videoId).moderationStatus == 'approved'
          || videoDoc(videoId).uid == request.auth.uid
        );
    }

    // --- Chat (conversations, members, messages, reactions, typing) ---
    function convDoc(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId)).data;
    }

    function isConvMember(convId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(convId))
        && request.auth.uid in convDoc(convId).memberIds;
    }

    function follows(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/following/$(b));
    }

    function canDm(sender, recipient) {
      // Beta behavior: anyone can DM anyone unless blocked.
      // Block enforcement happens in `isBlockedPair()` inside conversation create.
      return signedIn();
    }

    function dmOtherUid(mids) {
      return mids[0] == request.auth.uid ? mids[1] : mids[0];
    }

    function isBlockedPair(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/userBlocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/userBlocks/$(a));
    }

    function validMessageText(t) {
      return t is string && t.size() >= 0 && t.size() <= 4000;
    }

    function validAttachments(atts) {
      return atts == null
        || (atts is list && atts.size() <= 4);
    }

    match /conversations/{convId} {
      // Allow read when missing so `getDoc()` can safely check existence before create.
      // Without this, clients cannot "get or create" a deterministic DM id.
      allow read: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(convId))
          || isConvMember(convId)
        );

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.memberCount == request.resource.data.memberIds.size()
        && request.resource.data.type in ['dm', 'group']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && (
          (
            request.resource.data.type == 'dm'
            && request.resource.data.memberIds.size() == 2
            && request.resource.data.dmPairKey is string
            && canDm(request.auth.uid, dmOtherUid(request.resource.data.memberIds))
            && !isBlockedPair(
              request.resource.data.memberIds[0],
              request.resource.data.memberIds[1]
            )
          )
          || (request.resource.data.type == 'group')
        );

      allow update: if signedIn()
        && isConvMember(convId)
        // Members may only update activity metadata; never membership or creator fields.
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.type == resource.data.type
        && request.resource.data.dmPairKey == resource.data.dmPairKey
        && request.resource.data.memberCount == resource.data.memberCount
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt', 'lastActivityAt', 'lastMessage']);

      allow delete: if false;

      match /conversationMembers/{userId} {
        allow read: if signedIn() && isConvMember(convId);

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/conversations/$(convId))
          && request.auth.uid in convDoc(convId).memberIds
          && (
            // Creator can bootstrap all member rows.
            convDoc(convId).createdBy == request.auth.uid
            // Any member can (re)create their own member row if missing.
            || request.auth.uid == userId
          )
          && request.resource.data.memberUid == userId;

        allow update: if signedIn() && isConvMember(convId);

        allow delete: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && isConvMember(convId);

        allow create: if signedIn()
          && isConvMember(convId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == convId
          && validMessageText(request.resource.data.text)
          && validMessageText(request.resource.data.searchText)
          && validAttachments(request.resource.data.attachments)
          && (
            !request.resource.data.keys().hasAny(['kind'])
            || request.resource.data.kind in ['text', 'system', 'share_post']
          )
          && (
            !request.resource.data.keys().hasAny(['deletedForEveryone'])
            || request.resource.data.deletedForEveryone == false
          );

        allow update: if signedIn()
          && isConvMember(convId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text', 'searchText', 'editedAt', 'deletedForSelfUids']);

        allow delete: if false;

        match /messageReactions/{reactionId} {
          allow read: if signedIn() && isConvMember(convId);
          allow create: if signedIn()
            && isConvMember(convId)
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.emoji is string
            && request.resource.data.emoji.size() > 0
            && request.resource.data.emoji.size() < 32;
          allow delete: if signedIn() && isConvMember(convId) && resource.data.userId == request.auth.uid;
          allow update: if false;
        }
      }

      match /typing/{userId} {
        allow read: if signedIn() && isConvMember(convId);
        allow create, update: if signedIn() && isConvMember(convId) && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /userPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /messageReports/{reportId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.conversationId is string
        && request.resource.data.messageId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() < 500;
      allow update, delete: if false;
    }

    // Daily post is unique per user per challenge day (doc id `${uid}_${challengeDate}`).
    match /videos/{videoId} {
      // Allow read when the doc is missing so `onSnapshot` (e.g. “posted today?”) does not throw
      // permission-denied — `resource.data` is not valid if the document does not exist.
      allow read: if signedIn()
        && (
          !exists(/databases/$(database)/documents/videos/$(videoId))
          || resource.data.moderationStatus == 'approved'
          || resource.data.uid == request.auth.uid
          || isAdmin()
        );

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        // Beta: allow immediate posting (no moderation gate).
        && (
          request.resource.data.moderationStatus == 'pending'
          || request.resource.data.moderationStatus == 'approved'
        );

      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationStatus'])
        && request.resource.data.moderationStatus in ['approved', 'pending', 'rejected'];
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Server-managed throttling ledger for view counting (callable uses Admin SDK).
      match /viewMarks/{viewerId} {
        allow read, write: if false;
      }

      match /likes/{likerId} {
        allow read: if canReadVideoDoc(videoId);
        allow create: if canReadVideoDoc(videoId) && signedIn() && request.auth.uid == likerId;
        allow delete: if signedIn()
          && (
            request.auth.uid == likerId
            || (
              exists(/databases/$(database)/documents/videos/$(videoId))
              && get(/databases/$(database)/documents/videos/$(videoId)).data.uid == request.auth.uid
            )
          );
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if canReadVideoDoc(videoId);
        allow create: if canReadVideoDoc(videoId)
          && signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 500;
        allow delete: if signedIn()
          && exists(/databases/$(database)/documents/videos/$(videoId))
          && (
            isAdmin()
            || get(/databases/$(database)/documents/videos/$(videoId)).data.uid == request.auth.uid
            || resource.data.uid == request.auth.uid
          );
        allow update: if false;
      }
    }

    // Attempt ledger for enforcing max tries + coordinating with unique video doc id.
    match /postAttempts/{attemptId} {
      allow read: if signedIn() && attemptId.matches('^' + request.auth.uid + '_.+');
      allow create, update: if signedIn() && attemptId.matches('^' + request.auth.uid + '_.+');
      allow delete: if signedIn() && attemptId.matches('^' + request.auth.uid + '_.+');
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'isAdmin',
          'email',
          'verticalScore',
          'verticalScoreBreakdown',
          'verticalScoreUpdatedAt',
          'bestVerticalGainPostId',
          'bestVerticalGainPoints',
          'highestJumpDisplayInches',
        ]);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin',
          'email',
          'verticalScore',
          'verticalScoreBreakdown',
          'verticalScoreUpdatedAt',
          'bestVerticalGainPostId',
          'bestVerticalGainPoints',
          'highestJumpDisplayInches',
        ]);
      allow delete: if false;

      // In-app inbox (likes / comments / follows). Only recipient reads; actors create docs.
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.type in ['like', 'comment', 'follow']
          && request.resource.data.fromUsername is string
          && request.resource.data.read == false
          && request.auth.uid != userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Who you follow — visible only to you. No public follower lists or counts.
      match /following/{targetUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.auth.uid == userId
          && userId != targetUid
          && request.resource.data.targetUsername is string;
        allow delete: if isOwner(userId);
        allow update: if false;
      }

      // Expo push tokens for this user (one doc per device). Used by Cloud Functions only to send pushes.
      match /pushDevices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.token is string
          && request.resource.data.platform is string;
        allow delete: if isOwner(userId);
      }

      match /userBlocks/{blockedUid} {
        allow read: if isOwner(userId);
        allow create, delete: if isOwner(userId) && userId != blockedUid;
        allow update: if false;
      }
    }

    // Server-only (Cloud Functions admin SDK). Holds short-lived email sign-in OTPs + rate limits.
    match /loginOtps/{id} {
      allow read, write: if false;
    }

    match /loginOtpRate/{id} {
      allow read, write: if false;
    }

    match /challenges/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
  }
}
